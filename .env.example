# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# --- Required ---------------------------------------------------------------
# Local MongoDB, or an Atlas connection string for the deployed instance.
MONGO_URI=mongodb://127.0.0.1:27017/kyu_hostel

# Signs login tokens. Any long random string. Changing it logs everyone out.
JWT_SECRET=change_me_to_a_long_random_string

NODE_ENV=development
PORT=5000

# --- Optional: email ---------------------------------------------------------
# Booking confirmation emails are skipped if these are absent; nothing else
# is affected. For Gmail this must be an App Password, not your account
# password (Google account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Optional: CORS ---------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# Leave blank to allow any origin (fine for local development).
# In production, name your real frontends, e.g.:
#   CORS_ORIGINS=https://homies.vercel.app,https://homies.pages.dev
CORS_ORIGINS=
